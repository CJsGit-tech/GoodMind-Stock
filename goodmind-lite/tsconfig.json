{
  "compilerOptions": {
    "target": "es2022", "lib": ["dom", "dom.iterable", "esnext"], "skipLibCheck": true, "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true,
    "jsx": "react-jsx", "esModuleInterop": true, "allowImportingTsExtensions": false, "types": ["node", "vite/client"]
