{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "goodmind-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "goodmind-lite",
        "run",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "deploy-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3200",
        "--directory",
        "deploy-goodmind/out"
      ],
      "port": 3200
    }
  ]
}