{
  "name": "pocket-stock-staging",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore './.local/**' local/server.ts",
    "start": "tsx local/server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:local": "node --import tsx --test local/tests/*.test.ts",
    "test:backend": "node tests/backend-index.test.mjs && node tests/etf-reports.test.mjs && node --experimental-transform-types --loader ./backend/tests/etf-data-loader.test.mjs backend/tests/etf-data.test.mjs && node --experimental-transform-types --loader ./backend/tests/etf-data-loader.test.mjs backend/tests/etf-industry-history.test.mjs",
    "test:markdown": "node --import tsx --test tests/etf-markdown.test.ts tests/etf-research.test.ts tests/etf-cover.test.ts",
    "test": "npm run test:local && npm run test:backend && npm run test:markdown",
    "import:content": "node --import tsx local/import-content.ts",
    "seed:demo": "node --import tsx local/seed-demo.mjs",
    "test:ui": "node --import tsx local/tests/ui-smoke.mjs",
    "test:ui:markdown": "node --import tsx local/tests/etf-markdown-ui.mjs",
    "test:loading": "node tests/loading-contract.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "playwright": "1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
