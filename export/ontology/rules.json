  {
    "id": "R-derive-competition",
    "kind": "derivation",
    "description": "Each complete CompetitionAssessment projects a product-level link (DIRECTLY/INDIRECTLY_COMPETES_WITH) and company-level links (DIRECT/INDIRECT_COMPETITOR_OF) between the companies that SELL or BRAND the two offerings. Projections inherit verification, evidence and overlap_scope.",
    "produces": [
      "DIRECTLY_COMPETES_WITH",
      "INDIRECTLY_COMPETES_WITH",
      "DIRECT_COMPETITOR_OF",
      "INDIRECT_COMPETITOR_OF"
    ],
    "from": "CompetitionAssessment",
    "when": {
      "complete": true
    },
    "implementation": "lib/derive.ts#deriveEdges"
  },
  {
    "id": "R-derive-collaboration",
    "kind": "derivation",
    "description": "Every pair of Company participants of a Collaboration gets a COLLABORATES_WITH link carrying the collaboration stage.",
    "produces": [
      "COLLABORATES_WITH"
    ],
    "from": "Collaboration",
    "when": {
      "participants_min": 2
    },
    "implementation": "lib/derive.ts#deriveEdges"
  },
  {
    "id": "R-derive-supply",
    "kind": "derivation",
    "description": "SupplyRelationship at design_win, mass_production or unspecified stage projects SUPPLIES_TO; at prospect, qualified or sampling it projects MAY_SUPPLY_TO. Open CustomerOpportunity records also project MAY_SUPPLY_TO. Ended links are not projected.",
    "produces": [
      "SUPPLIES_TO",
      "MAY_SUPPLY_TO"
    ],
    "from": "SupplyRelationship|CustomerOpportunity",
    "when": {
      "stage_not": [
